{
  "lines": [
    {
      "t": 23.12,
      "text": "休伯曼说创造力很难捕捉"
    },
    {
      "t": 35.08,
      "text": "里克把创意比作一片云"
    },
    {
      "t": 40.24,
      "text": "此刻看见一种形状"
    },
    {
      "t": 45.92,
      "text": "下一刻它可能已经改变"
    },
    {
      "t": 48.04,
      "text": "再晚一些甚至会消失"
    }
  ]
}
