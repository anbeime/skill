{
  "lines": [
    {
      "t": 1347.24,
      "text": "모든 행동 앞에는 시작의 언덕이 있다"
    },
    {
      "t": 1350.72,
      "text": "그 언덕을 넘어야 비로소 시작한다"
    },
    {
      "t": 1356.08,
      "text": "누군가에겐 언어 공부가 산과 같다"
    },
    {
      "t": 1363.04,
      "text": "다른 이에겐 낮은 언덕일 뿐이다"
    },
    {
      "t": 1371.6,
      "text": "문턱은 시작하기도 전에 생긴다"
    }
  ]
}
