  "lines": [
    {
      "t": 25.84,
      "text": "Rick says everyone wants acceptance"
    },
    {
      "t": 27.6,
      "text": "But pleasing others is not the way"
    },
    {
      "t": 32.88,
      "text": "The surer path is being yourself"
    },
    {
      "t": 36.88,
      "text": "You cannot know what others think"
    },
    {
      "t": 42.56,
      "text": "Abandoning yourself leaves a mask"
    }
  ]
}
